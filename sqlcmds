================================================================
CANOPY POSTGRESQL CHEATSHEET (Docker Compose)
Run all commands from inside: ~/Desktop/k8s/canopy
================================================================

1. OPEN INTERACTIVE PSQL SHELL
------------------------------
docker compose exec db psql -U canopy -d canopy


2. USEFUL COMMANDS INSIDE PSQL
------------------------------
\dt                          -- List all tables
\d admins                    -- Show columns/types of 'admins' table
\d admin_sessions            -- Show columns/types of 'admin_sessions' table
\du                          -- List database users/roles
\x                           -- Toggle expanded vertical view (great for wide rows)
\q                           -- Quit psql


3. SQL QUERIES TO INSPECT DATA (INSIDE PSQL)
--------------------------------------------
-- View all admin accounts (hiding full password hash)
SELECT id, username, display_name, title, left(password_hash, 18) AS hash_preview, created_at
FROM admins;

-- View all currently active login sessions
SELECT a.username, a.display_name, left(s.token_hash, 12) AS session_id, s.created_at, s.expires_at
FROM admin_sessions s
JOIN admins a ON a.id = s.admin_id
WHERE s.expires_at > NOW();

-- Count active sessions
SELECT COUNT(*) FROM admin_sessions WHERE expires_at > NOW();

-- Force sign-out everyone (delete all sessions)
DELETE FROM admin_sessions;

-- Delete only expired sessions
DELETE FROM admin_sessions WHERE expires_at <= NOW();


4. QUICK ONE-LINERS FROM MAC TERMINAL (NO INTERACTIVE SHELL)
------------------------------------------------------------
# List tables
docker compose exec db psql -U canopy -d canopy -c "\dt"

# Check admins
docker compose exec db psql -U canopy -d canopy -c "SELECT id, username, display_name, title FROM admins;"

# Check active sessions
docker compose exec db psql -U canopy -d canopy -c "SELECT a.username, s.expires_at FROM admin_sessions s JOIN admins a ON a.id = s.admin_id;"

# Re-seed / update admin passwords after editing .env
docker compose up -d api
docker compose exec api node seed-admins.js


5. BACKUP DATABASE TO A SQL FILE
--------------------------------
docker compose exec db pg_dump -U canopy -d canopy > canopy_backup_$(date +%Y%m%d).sql